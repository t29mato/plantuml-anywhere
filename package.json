{
  "name": "plantuml-web",
  "publisher": "plantuml-web-poc",
  "displayName": "PlantUML Web Preview (PoC)",
  "description": "Zero-install PlantUML preview for VS Code — no Java, no Graphviz, no server. Works in github.dev.",
  "version": "0.1.4",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/t29mato/plantuml-web.git"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualizers"
  ],
  "keywords": [
    "plantuml",
    "uml",
    "diagram",
    "preview",
    "web extension",
    "no-java",
    "no-graphviz"
  ],
  "browser": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:plantuml",
    "onStartupFinished"
  ],
  "contributes": {
    "languages": [
      {
        "id": "plantuml",
        "extensions": [
          ".puml",
          ".plantuml"
        ]
      }
    ],
    "commands": [
      {
        "command": "plantuml-web.preview",
        "title": "PlantUML: Preview"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "plantuml-web.preview",
          "when": "resourceLangId == plantuml"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:e2e-test": "esbuild test-web/index.ts --bundle --platform=browser --target=es2022 --format=cjs --external:vscode --outfile=dist/test-web/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "depcruise src --config .dependency-cruiser.cjs",
    "test:unit": "vitest run",
    "pretest:e2e": "npm run build && npm run build:e2e-test",
    "test:e2e": "vscode-test-web --headless --esm --extensionDevelopmentPath=. --extensionTestsPath=dist/test-web/index.js test-fixtures",
    "ci": "bash scripts/ci.sh",
    "prepackage": "npm run build",
    "package": "vsce package",
    "try:web": "vscode-test-web --esm --extensionDevelopmentPath=. test-fixtures",
    "build:browser-extension": "node esbuild.browser-extension.mjs",
    "package:browser-extension": "bash scripts/package-browser-extension.sh"
  },
  "devDependencies": {
    "@plantuml/core": "1.2026.6",
    "@types/vscode": "^1.85.0",
    "@vscode/test-web": "^0.0.63",
    "@vscode/vsce": "^3.9.2",
    "canvas": "^3.2.3",
    "dependency-cruiser": "^18.2.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "allowScripts": {
    "canvas@3.2.3": true
  }
}
