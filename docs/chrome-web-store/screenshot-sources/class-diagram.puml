@startuml
left to right direction
skinparam classFontSize 15
skinparam classAttributeFontSize 13
skinparam nodesep 40
skinparam ranksep 60

class Customer {
  +name: String
  +email: String
}
class Order {
  +id: String
  +status: OrderStatus
  +total(): Money
}
class LineItem {
  +quantity: int
  +subtotal(): Money
}
class Product {
  +name: String
  +price: Money
}
class Payment {
  +method: String
  +charge(): Receipt
}
class Warehouse {
  +location: String
  +ship(): Tracking
}

Customer "1" -- "*" Order : places
Order "1" *-- "*" LineItem : contains
LineItem "*" --> "1" Product : refers to
Order "1" *-- "1" Payment : paid by
Order "1" --> "1" Warehouse : fulfilled by
@enduml
